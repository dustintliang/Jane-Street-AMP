import itertools
import math

def palindronic_sums2(max: int) -> int:
    numbers = set()
    for i in range(1, int(math.sqrt(max)) + 1):
        consec_square = i * i
        n = 1
        while consec_square + (i + n)**2 < max:
            consec_square += (i + n)**2
            consec_square_str = str(consec_square)
            if consec_square_str == consec_square_str[ : : -1]:
                numbers.add(consec_square)
            n += 1
    return sum(numbers)

print(palindronic_sums2(10**8))

def palindronic_sums(max: int) -> int:
    numbers = set()
    for i in range(1, int(math.sqrt(max)) + 1):
        consec_square = i * i
        for next_square in itertools.count(i + 1):
            if consec_square + next_square**2 >= max:
                break
            consec_square += next_square**2
            consec_square_str = str(consec_square)
            if consec_square_str == consec_square_str[ : : -1]:
                numbers.add(consec_square)
    return sum(numbers)

print(palindronic_sums(10**8))

def quadratic_primes(a_max: int, b_max: int) -> int:
    def is_prime_factor_fold(n: int) -> bool:
        if n < 2:
            return False
        if n == 2:
            return True
        if n % 2 == 0:
            return False
        for i in range(3, int(math.sqrt(n)+1), 2):
            if n % i == 0:
                return False
        return True
    max_a = 0
    max_b = 0
    max_n = 0
    for a in range(-a_max, a_max):
        for b in range(-b_max, b_max + 1):
            n = 0
            while True:
                prime_test = int(n**2 + a*n + b)
                if is_prime_factor_fold(prime_test) == True:
                    n += 1
                else:
                    break
            if n > max_n:
                max_n, max_a, max_b = n, a, b
    return max_a*max_b

print(quadratic_primes(1000, 1000))

